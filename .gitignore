# ───────────────────────────────────────────────
#  Mini ERP + CRM — .gitignore
# ───────────────────────────────────────────────

# ── Node ────────────────────────────────────────
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Environment Variables ────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Keep .env.example (needed for reviewers)

# ── Build Outputs ────────────────────────────────
dist/
build/
.dist/
out/

# ── Prisma generated client (auto-generated) ─────
# backend/node_modules/@prisma/ is covered by node_modules above
backend/src/generated/

# ── Local Embedded Postgres Data ─────────────────
# Contains the actual postgres DB files — never commit
backend/data/
data/
*.sql.bak

# ── Logs ─────────────────────────────────────────
*.log
logs/
*.log.*

# ── SQLite (if used locally) ──────────────────────
*.sqlite
*.sqlite-journal
*.db

# ── OS ───────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / Editor ─────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cursor/

# ── Test Coverage ────────────────────────────────
coverage/
.nyc_output/

# ── Misc ─────────────────────────────────────────
*.tgz
*.zip
*.tar.gz
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache

# ── Scratch / Temp (AI workspace files) ──────────
scratch/
.temp/
*.tmp

# ── Internal build/status tracking docs ──────────
# These are internal workflow files, not needed in the submitted repo
PROJECT_STATUS.md
