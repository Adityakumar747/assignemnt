# Environment Override File
# Copy this to .env and fill in production values before deploying.

# -- Database ------------------------------------
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_secret_2024
POSTGRES_DB=mini_erp_crm

# -- Backend -------------------------------------
JWT_SECRET=change_this_to_a_strong_secret_in_production_at_least_64_characters_long
JWT_EXPIRES_IN=7d

# -- CORS ----------------------------------------
# Set to your deployed frontend URL in production
CORS_ORIGIN=http://localhost:3000

# -- Frontend (build-time) -----------------------
# Set to your deployed backend API URL
VITE_API_URL=http://localhost:5000
